---
import Layout from '../../../layouts/Layout.astro';
import { verifyAdminAuth } from '../../../lib/auth';

const user = await verifyAdminAuth(Astro.cookies);
if (!user) {
  return Astro.redirect('/admin/login');
}

const supabaseUrl = import.meta.env.VITE_SUPABASE_URL;
const anonKey = import.meta.env.VITE_SUPABASE_ANON_KEY;
---

<Layout title="Nouvel article - WFA & Partners">
  <div class="min-h-screen bg-gray-900">
    <header class="bg-black border-b border-gray-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
          <div class="flex items-center">
            <a href="/admin/articles" class="text-gray-400 hover:text-white mr-4 text-sm">← Articles</a>
            <h1 class="text-xl font-bold text-white">Nouvel article</h1>
          </div>
          <a href="/admin/logout" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg text-sm">
            Déconnexion
          </a>
        </div>
      </div>
    </header>

    <main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <form id="articleForm" class="space-y-6">
        <div id="formError" class="hidden bg-red-900/50 border border-red-500 text-red-200 px-4 py-3 rounded-lg"></div>

        <div>
          <label for="title" class="block text-sm font-medium text-gray-300 mb-2">Titre *</label>
          <input
            type="text"
            id="title"
            name="title"
            required
            class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            placeholder="Titre de l'article"
          />
        </div>

        <div>
          <label for="description" class="block text-sm font-medium text-gray-300 mb-2">Description courte *</label>
          <textarea
            id="description"
            name="description"
            rows="3"
            required
            class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            placeholder="Résumé affiché sur les cartes d'articles"
          ></textarea>
        </div>

        <div>
          <label for="content" class="block text-sm font-medium text-gray-300 mb-2">Contenu complet *</label>
          <textarea
            id="content"
            name="content"
            rows="10"
            required
            class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            placeholder="Contenu détaillé de l'article..."
          ></textarea>
        </div>

        <div>
          <label for="category" class="block text-sm font-medium text-gray-300 mb-2">Catégorie *</label>
          <select
            id="category"
            name="category"
            required
            class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          >
            <option value="">Sélectionnez une catégorie</option>
            <option value="architecture">Architecture</option>
            <option value="construction">Construction</option>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-300 mb-2">Images de l'article (1 à 5) *</label>
          <input
            type="file"
            id="images"
            name="images"
            accept="image/*"
            multiple
            class="hidden"
          />
          <button
            type="button"
            id="imageBtn"
            class="px-4 py-2 bg-gray-700 hover:bg-gray-600 text-white rounded-lg text-sm"
          >
            Choisir des images
          </button>
          <span id="imageFileName" class="text-gray-400 text-sm ml-4">Aucune image sélectionnée</span>
          <p class="text-gray-500 text-xs mt-2">La première image sera utilisée comme image principale. Vous pouvez sélectionner jusqu'à 5 images.</p>
          <div id="imagePreview" class="grid grid-cols-3 gap-3 mt-4 hidden"></div>
        </div>

        <div class="flex items-center">
          <input
            type="checkbox"
            id="published"
            name="published"
            class="w-4 h-4 text-blue-600 bg-gray-800 border-gray-600 rounded focus:ring-blue-500"
          />
          <label for="published" class="ml-2 text-sm text-gray-300">Publier immédiatement</label>
        </div>

        <div class="flex space-x-4">
          <button
            type="submit"
            id="submitBtn"
            class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition-colors"
          >
            Créer l'article
          </button>
          <a href="/admin/articles" class="px-6 py-2 bg-gray-700 hover:bg-gray-600 text-white rounded-lg font-medium transition-colors">
            Annuler
          </a>
        </div>
      </form>
    </main>
  </div>

  <script is:inline define:vars={{ supabaseUrl, anonKey }}>
    const MAX_IMAGES = 5;
    const fileInput = document.getElementById('images');
    const imageBtn = document.getElementById('imageBtn');
    const imageFileName = document.getElementById('imageFileName');
    const imagePreview = document.getElementById('imagePreview');
    let selectedFiles = [];

    imageBtn.addEventListener('click', () => fileInput.click());

    fileInput.addEventListener('change', () => {
      const newFiles = Array.from(fileInput.files);
      selectedFiles = [...selectedFiles, ...newFiles].slice(0, MAX_IMAGES);
      renderPreviews();
    });

    function renderPreviews() {
      if (selectedFiles.length === 0) {
        imageFileName.textContent = 'Aucune image sélectionnée';
        imagePreview.classList.add('hidden');
        imagePreview.innerHTML = '';
      } else {
        imageFileName.textContent = selectedFiles.length + ' image(s) sélectionnée(s)';
        imagePreview.classList.remove('hidden');
        imagePreview.innerHTML = selectedFiles.map((file, i) => {
          const url = URL.createObjectURL(file);
          const isFirst = i === 0;
          return '<div class="relative">' +
            '<img src="' + url + '" class="w-full h-24 object-cover rounded-lg border ' + (isFirst ? 'border-blue-500' : 'border-gray-700') + '" />' +
            (isFirst ? '<span class="absolute top-1 left-1 bg-blue-600 text-white text-xs px-1.5 py-0.5 rounded">Principale</span>' : '') +
            '<button type="button" data-remove="' + i + '" class="absolute top-1 right-1 bg-red-600 text-white w-5 h-5 rounded-full text-xs flex items-center justify-center">x</button>' +
            '</div>';
        }).join('');

        imagePreview.querySelectorAll('[data-remove]').forEach(btn => {
          btn.addEventListener('click', () => {
            const idx = parseInt(btn.dataset.remove);
            selectedFiles.splice(idx, 1);
            renderPreviews();
          });
        });
      }
      fileInput.value = '';
    }

    document.getElementById('articleForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById('submitBtn');
      const formError = document.getElementById('formError');
      formError.classList.add('hidden');

      if (selectedFiles.length === 0) {
        formError.classList.remove('hidden');
        formError.textContent = 'Veuillez sélectionner au moins une image';
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Création...';

      try {
        const token = document.cookie
          .split('; ')
          .find(c => c.startsWith('sb_access_token='))
          ?.split('=')[1];

        const imageUrls = [];
        for (const file of selectedFiles) {
          const fileExt = file.name.split('.').pop();
          const fileName = `${Date.now()}-${Math.random().toString(36).substring(7)}.${fileExt}`;

          const uploadRes = await fetch(`${supabaseUrl}/storage/v1/object/article-images/${fileName}`, {
            method: 'POST',
            headers: {
              'Authorization': `Bearer ${token}`,
              'Content-Type': file.type,
            },
            body: file,
          });

          if (!uploadRes.ok) {
            throw new Error('Erreur lors de l\'upload d\'une image');
          }

          imageUrls.push(`${supabaseUrl}/storage/v1/object/public/article-images/${fileName}`);
        }

        const articleData = {
          title: document.getElementById('title').value,
          description: document.getElementById('description').value,
          content: document.getElementById('content').value,
          category: document.getElementById('category').value,
          image_url: imageUrls[0],
          images: imageUrls,
          published: document.getElementById('published').checked,
        };

        const res = await fetch(`${supabaseUrl}/rest/v1/articles`, {
          method: 'POST',
          headers: {
            'apikey': anonKey,
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
            'Prefer': 'return=minimal',
          },
          body: JSON.stringify(articleData),
        });

        if (res.ok) {
          window.location.href = '/admin/articles';
        } else {
          const err = await res.json();
          throw new Error(err.message || 'Erreur lors de la création');
        }
      } catch (error) {
        formError.classList.remove('hidden');
        formError.textContent = error.message || 'Erreur lors de la création de l\'article';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Créer l'article';
      }
    });
  </script>
</Layout>
